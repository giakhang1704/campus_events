# Copy to .env for Docker Compose only. Replace before starting.
POSTGRES_DB=campus_events_dev
POSTGRES_USER=campus_app
POSTGRES_PASSWORD=replace-with-your-local-password
FRONTEND_PORT=4200
BACKEND_PORT=8080
POSTGRES_PORT=5432

# Set true only when the app is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Opt in to real transactional email only after verifying the sender.
MAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BKevent
